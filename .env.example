# ASTRAHEALTH AI — local configuration. Copy to .env and adjust.
APP_MODE=offline
# SQLite file (relative to backend/)
DATABASE_PATH=./data/astrahealth.db
# Optional local LLM (explanations only). Must be a loopback address.
LOCAL_LLM_PROVIDER=ollama
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434
LOCAL_LLM_MODEL=qwen2.5:3b
LOCAL_LLM_ENABLED=true
LOCAL_LLM_TIMEOUT_S=180
KNOWLEDGE_DIR=../knowledge
RULESET_PATH=./rules/ruleset.v1.json
ENABLE_SYNTHETIC_DATA=true
# Enforced in code: when false, a socket-level guard refuses non-loopback connections and DNS.
ALLOW_EXTERNAL_NETWORK=false
LOG_LEVEL=INFO
MIN_BASELINE_POINTS=7
MIN_ANOMALY_DAYS=14
AGENT_TIMEOUT_S=10
# Move the synthetic demo timeline forward on start so seeded history always ends yesterday.
DEMO_CLOCK_SHIFT=true
# Optional fixed PINs (otherwise random PINs are generated in backend/data/credentials.json on first start).
# MEDICAL_OFFICER_PIN=
# ADMIN_PIN=
